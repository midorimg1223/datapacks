#By ZCode —— 悬浮字工具 · 用法
tellraw @s [{"text":"════ 悬浮字工具 ════","color":"gold","bold":true}]
tellraw @s [{"text":"放置：","color":"yellow"},{"text":"站到位置 → /function board:text_place","color":"gray"}]
tellraw @s [{"text":"改内容：","color":"yellow"},{"text":"先把文本组件塞进 storage，再执行 text_edit","color":"gray"}]
tellraw @s [{"text":"    /data modify storage board:edit text set value {text:\"亡灵矿区\",color:\"gold\",bold:true}","color":"dark_gray"}]
tellraw @s [{"text":"    /function board:text_edit","color":"dark_gray"},{"text":"（改离你最近的那个，8 格内）","color":"gray"}]
tellraw @s [{"text":"改外观：","color":"yellow"},{"text":"/data modify storage board:edit display set value {billboard:\"center\",size:1.5d}","color":"dark_gray"}]
tellraw @s [{"text":"    再执行一次 text_edit。billboard 可选 center / vertical / horizontal / fixed","color":"gray"}]
tellraw @s [{"text":"挪位置：","color":"yellow"},{"text":"/function board:text_move","color":"gray"},{"text":"（挪到你脚下）","color":"gray"}]
tellraw @s [{"text":"清理：","color":"yellow"},{"text":"/function board:text_clear","color":"gray"},{"text":"（清掉所有悬浮字）","color":"gray"}]
tellraw @s [{"text":"手动微调：","color":"yellow"},{"text":"/data modify entity @e[tag=board_text,sort=nearest,limit=1] ...","color":"gray"}]
tellraw @s [{"text":"  文本组件字段都能用：text / color / bold / italic / underlined / strikethrough / obfuscated，颜色可用 #RRGGBB","color":"dark_gray"}]
tellraw @s [{"text":"  换行：写 {\"text\":\"第一行\\n第二行\"}（中文和空格都行）","color":"dark_gray"}]
tellraw @s [{"text":"注意：","color":"yellow"},{"text":"悬浮字是世界实体、所有人都看得见；只给某个人看的数字请用 bossbar / actionbar","color":"gray"}]
